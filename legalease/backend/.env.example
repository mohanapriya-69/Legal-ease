# --- Application -----------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Database --------------------------------------------------------
# Local development. For PostgreSQL, replace with, e.g.:
# DATABASE_URL=postgresql+psycopg://legalease:password@localhost:5432/legalease
DATABASE_URL=sqlite:///./legalease.db

# --- Groq ------------------------------------------------------------
# Create a key at https://console.groq.com/keys
# Leave blank to run in demo mode (deterministic sample output, clearly marked).
GROQ_API_KEY=

# OpenAI-compatible base URL. Override only for a proxy or regional endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model is read from the environment - no model name is hardcoded in source.
# List what your key can reach: https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

# Generation tuning
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=8192
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=2

# --- Demo mode -------------------------------------------------------
# When true and no GROQ_API_KEY is set, LegalEase generates deterministic
# sample documents so the whole workflow can be evaluated offline.
# Every such document is labelled "Demo AI Response".
DEMO_MODE=true

# --- Frontend / CORS -------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --- Uploads ---------------------------------------------------------
MAX_LOGO_BYTES=2097152
